# ChatPulse Server - 多阶段构建
# 阶段1: 构建
FROM ubuntu:20.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 配置时区
RUN apt-get update && apt-get install -y tzdata && \
    ln -fs /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    dpkg-reconfigure -f noninteractive tzdata && \
    rm -rf /var/lib/apt/lists/*

# 安装编译工具链和依赖库
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libmysqlclient-dev \
    libhiredis-dev \
    libboost-all-dev \
    libssl-dev \
    wget \
    unzip \
    librdkafka-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# 下载并安装 protobuf 3.15.8（完整版：库+编译器）
RUN cd /tmp && \
    wget -q https://github.com/protocolbuffers/protobuf/releases/download/v3.15.8/protobuf-cpp-3.15.8.tar.gz && \
    tar -xzf protobuf-cpp-3.15.8.tar.gz && \
    cd protobuf-3.15.8 && \
    ./configure --prefix=/usr/local && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    rm -rf /tmp/protobuf*

# 下载并安装 muduo 网络库
RUN cd /tmp && \
    git clone --depth 1 https://github.com/chenshuo/muduo.git && \
    cd muduo && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    rm -rf /tmp/muduo

WORKDIR /build

COPY . .

RUN mkdir -p build && cd build && \
    cmake .. \
    -DCMAKE_PREFIX_PATH=/usr/local \
    -DProtobuf_INCLUDE_DIR=/usr/local/include \
    -DProtobuf_LIBRARIES=/usr/local/lib/libprotobuf.so \
    -DProtobuf_PROTOC_EXECUTABLE=/usr/local/bin/protoc && \
    make -j$(nproc)

# 阶段2: 运行镜像
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 配置时区
RUN apt-get update && apt-get install -y tzdata && \
    ln -fs /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    dpkg-reconfigure -f noninteractive tzdata && \
    rm -rf /var/lib/apt/lists/*

# 仅安装运行时需要的库
RUN apt-get update && apt-get install -y \
    libmysqlclient-dev \
    libhiredis-dev \
    libboost-all-dev \
    libssl-dev \
    librdkafka-dev \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 从构建阶段复制 protobuf 运行时库
COPY --from=builder /usr/local/lib/libprotobuf* /usr/local/lib/
RUN ldconfig

COPY --from=builder /build/bin ./bin

EXPOSE 6000
EXPOSE 8888

ENV SERVER_PORT=6000
ENV MCP_PORT=8888

CMD /bin/sh -c './bin/ChatServer 0.0.0.0 ${SERVER_PORT} --mcp-port ${MCP_PORT}'
