# ============================================================
# ChatPulse 环境变量配置示例
# 复制此文件为 .env 并填写实际值:
#   cp .env.example .env
# ============================================================

# ── AI Agent ──────────────────────────────────────────────
# ModelScope API Key（必填，AI 智能助手需要）
# 获取: https://www.modelscope.cn → 模型服务 → API Key
MODELSCOPE_API_KEY=ms-your-api-key-here

# Tavily 联网搜索 API Key（可选，不填则 AI 无法联网搜索）
# 获取: https://tavily.com → Dashboard
TAVILY_API_KEY=tvly-your-api-key-here
